3c70ec7dc0ff5dfe048dd5001a1a65a4a5920dd23973ab67552f02b42f8290d25ac7d8cb239b79f6c3c41bb37129f5d30f0d0b555ac720a3dc02831ee517fdab  fix_qnx.patch
"
